{
  "mcpServers": {
    "localtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "some-mcp"
      ],
      "env": {
        "A": "1"
      },
      "startupTimeoutMs": 5000
    },
    "web": {
      "type": "http",
      "url": "https://mcp.example.com/mcp",
      "enabled": true
    }
  }
}