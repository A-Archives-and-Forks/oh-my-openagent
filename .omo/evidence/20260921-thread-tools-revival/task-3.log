import assert from "node:assert/strict";
import { spawn } from "node:child_process";
import { once } from "node:events";
import { mkdtempSync, mkdirSync, rmSync, realpathSync } from "node:fs";
import { join } from "node:path";
import { createLiveThreadSurface } from "./packages/omo-senpi/src/components/thread/live-surface.ts";
import { createThreadTools } from "./packages/omo-senpi/src/components/thread/tools.ts";
const directory = mkdtempSync("/tmp/thread-control-live-");
const agentDir = join(directory, "agent");
mkdirSync(agentDir);
const socket = join(directory, "rpc.sock");
const cli = realpathSync("node_modules/@code-yeongyu/senpi/dist/cli.js");
const child = spawn("node", [cli, "--mode", "rpc", "--multi-session", "--listen", `unix://${socket}`, "--no-extensions", "--no-skills", "--no-prompt-templates", "--no-themes"], {
  cwd: process.cwd(), windowsHide: true,
  env: { PATH: process.env.PATH, HOME: directory, OMO_CODING_AGENT_DIR: agentDir, SENPI_CODING_AGENT_DIR: agentDir, PI_CODING_AGENT_DIR: agentDir, SENPI_RPC_SOCKET: socket, TERM: "dumb", NO_COLOR: "1", OPENAI_API_KEY: "local-unused-no-network", OMO_DISABLE_POSTHOG: "1" },
  stdio: ["ignore", "pipe", "pipe"],
});
const exited = once(child, "exit");
let startup = "";
try {
  await new Promise((resolve, reject) => {
    const timer = setTimeout(() => reject(new Error(`Host readiness timed out: ${startup}`)), 30000);
    const finish = (error) => { clearTimeout(timer); child.stdout.off("data", onData); child.stderr.off("data", onData); child.off("error", finish); error ? reject(error) : resolve(); };
    const onData = chunk => { startup += chunk.toString(); if (startup.includes(`rpc listening on unix://${socket}`)) finish(); };
    child.stdout.on("data", onData); child.stderr.on("data", onData); child.once("error", finish);
    exited.then(([code]) => finish(new Error(`Host exited ${code}: ${startup}`)));
  });
  const host = createLiveThreadSurface({}, { env: { SENPI_RPC_SOCKET: socket } });
  const opened = await host.openSession({ cwd: process.cwd(), name: "live-thread-peer" });
  const peers = await host.listSessions();
  const peer = peers.find(session => session.sessionId === opened.sessionId);
  assert(peer, "opened peer must appear in listSessions");
  const callerId = peer.durableSessionId ?? peer.sessionId;
  const tools = createThreadTools({ host, stateDirectory: join(directory, "receipts"), callerSessionId: () => "unknown-caller", callerWorkspaceRoot: () => process.cwd() });
  let call = 0;
  const invoke = async (name, params) => {
    const tool = tools.find(tool => tool.name === name);
    assert(tool, `${name} must be registered`);
    const result = (await tool.execute(`manual-${++call}`, params, undefined, undefined, { sessionManager: { getSessionId: () => callerId } })).details.result;
    console.log(JSON.stringify({ tool: name, result }));
    return result;
  };
  assert.equal((await invoke("thread_rename", { thread: "self", name: "  live-renamed  " })).kind, "ok");
  assert.equal((await host.listSessions()).find(session => session.sessionId === opened.sessionId)?.name, "live-renamed");
  const catalog = await host.getAvailableModels(opened.sessionId);
  const model = catalog.find(model => model.provider === "openai" && model.id === "gpt-4o");
  assert(model, "isolated dummy-key catalog must expose gpt-4o without generation");
  assert.equal((await invoke("thread_set_model", { thread: "self", model: `${model.provider}/${model.id}` })).kind, "ok");
  const levels = await host.getAvailableThinkingLevels(opened.sessionId);
  assert.deepEqual(levels, ["off"]);
  const rejection = await invoke("thread_set_reasoning", { thread: "self", level: "high" });
  assert.equal(rejection.error?.code, "thinking_level_unsupported");
  assert.deepEqual(rejection.error.details.supported, ["off"]);
  const session = await invoke("thread_set_reasoning", { thread: "self", level: "off" });
  assert.equal(session.kind, "ok"); assert.equal(session.scope, "session");
  const turn = await invoke("thread_set_reasoning", { thread: "self", level: "off", scope: "turn" });
  assert.equal(turn.kind, "ok"); assert.equal(turn.scope, "turn");
  console.log(JSON.stringify({ manualLiveRpc: "PASS", catalogSize: catalog.length, isolatedAgentDir: agentDir, isolatedHome: directory, modelGenerationRequests: 0, realAgentDirectoryInChildEnvironment: false }));
} finally {
  if (child.exitCode === null && child.signalCode === null) child.kill("SIGTERM");
  const timeout = setTimeout(() => child.kill("SIGKILL"), 5000);
  await exited;
  clearTimeout(timeout);
  rmSync(directory, { recursive: true, force: true });
  console.log(JSON.stringify({ cleanup: "complete", childExitCode: child.exitCode, childSignal: child.signalCode }));
}
