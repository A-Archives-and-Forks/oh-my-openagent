{
  "mcpServers": {
    "local": {
      "type": "stdio",
      "command": "node",
      "args": [
        "dummy-mcp.js"
      ],
      "env": {
        "TOKEN": "${REVIEW_MCP_TOKEN}"
      }
    },
    "remote": {
      "type": "http",
      "url": "https://example.test/mcp",
      "headers": {
        "Authorization": "Bearer ${REVIEW_MCP_TOKEN}"
      }
    }
  }
}